    margin: 2px;
    border: 2px solid transparent;
}
QPushButton:hover {
    background-color: #e68900; /* 悬停时变深橙 */
    border: 2px solid orange;
}
QPushButton:pressed {
    background-color: #cc7a00; /* 按下时更深橙 */
    border: 2px solid darkorange;
}
QPushButton:disabled {
    background-color: #808080; /* 灰色背景表示禁用 */
    color: #C0C0C0; /* 浅灰色文字 */
    border: 2px solid #606060; /* 深灰色边框 */
}
</string>
